# Copie para .env (que não vai para o Git) e troque as senhas.
# Gere uma senha forte, por exemplo:  openssl rand -base64 24
ORBIT_DB_USUARIO=orbithub
ORBIT_DB_SENHA=troque-esta-senha
GRAFANA_SENHA=troque-esta-senha
# Porta do Postgres no seu computador; mude se a 5432 já estiver em uso.
ORBIT_DB_PORTA_HOST=5432
