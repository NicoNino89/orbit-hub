{
  "role": {
    "name": "orbit-hub-api"
  },
  "sampling": {
    "percentage": 50,
    "overrides": [
      {
        "telemetryType": "trace",
        "percentage": 100
      }
    ]
  },
  "instrumentation": {
    "logging": {
      "level": "INFO"
    },
    "micrometer": {
      "enabled": true
    }
  }
}
